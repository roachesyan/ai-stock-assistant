# ============================================================
# AI Quant Agent — 后端环境变量模板
# 复制为 backend/.env 后填入真实值；.env 已被 .gitignore 排除。
# ============================================================

# ---- LLM 提供商：glm（默认）| anthropic | openai ----
LLM_PROVIDER=glm

# ---- 智谱 GLM（默认，走 Anthropic 兼容端点）----
# GLM_API_KEY 形如 id.secret，请到智谱开放平台获取，切勿提交版本库
GLM_API_KEY=replace-with-your-glm-token
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-5.1
LLM_TIMEOUT_MS=3000000

# ---- 官方 Anthropic（LLM_PROVIDER=anthropic 时启用）----
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- OpenAI / 或 GLM 的 OpenAI 兼容端点（LLM_PROVIDER=openai 时启用）----
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 新闻搜索 ----
# 使用 Tavily 时填写；留空则回退到 DuckDuckGo（免费、无需 key）
TAVILY_API_KEY=

# ---- 数据库 / 服务 ----
DATABASE_PATH=./data/quant.db
API_HOST=0.0.0.0
API_PORT=8000

# ---- 跨域（前端开发地址）----
CORS_ORIGINS=http://localhost:5173

# ---- 多 Agent 循环上限 ----
MAX_SCHEMA_RETRIES=2
MAX_EVIDENCE_ROUNDS=2
MAX_RISK_ROUNDS=3
RISK_LIMIT_POLICY=EXECUTE_AND_FLAG

# ---- 定时调度（仅 Server 模式生效）----
SCHEDULE_ENABLED=false                 # 设为 true 开启每日自动分析
SCHEDULE_CRON=30 9 * * 1-5             # cron 表达式（按 SCHEDULE_TIMEZONE 解释）
SCHEDULE_TIMEZONE=America/New_York     # 美股时区；务必与市场一致
MARKET_CALENDAR=XNYS                   # pandas-market-calendars 日历名（XNYS=纽交所）
SKIP_NON_TRADING_DAYS=true             # 非交易日（周末/节假日）自动跳过

# ---- 目标股票代码（逗号分隔，可覆盖默认 Top 10）----
TICKERS=AAPL,MSFT,NVDA,GOOGL,META,TSLA,AMD,TSM,ASML,AVGO
